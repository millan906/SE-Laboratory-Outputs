# =============================================================================
# NOT ignored — legitimate lockfiles must be committed
# =============================================================================
# package-lock.json  ← do NOT ignore
# pnpm-lock.yaml     ← do NOT ignore
# yarn.lock          ← do NOT ignore
# poetry.lock        ← do NOT ignore
# Gemfile.lock       ← do NOT ignore
# Cargo.lock         ← do NOT ignore
# go.sum             ← do NOT ignore
# =============================================================================
